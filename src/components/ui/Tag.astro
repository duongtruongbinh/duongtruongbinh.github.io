---
import { getTagSlug } from "../../utils/tags";

interface Props {
    name: string;
    count?: number;
    size?: "sm" | "md" | "lg";
}

const { name, count, size = "md" } = Astro.props;

const sizeClasses = {
    sm: "text-xs",
    md: "text-sm",
    lg: "text-base",
};

const tagHref = `/tags/${getTagSlug(name)}`;
---

<a href={tagHref} class={`tag ${sizeClasses[size]}`}>
    #{name}
    {count !== undefined && <span class="opacity-60 ml-1">({count})</span>}
</a>
