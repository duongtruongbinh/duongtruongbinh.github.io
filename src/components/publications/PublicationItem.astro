---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import ContentLinks from "../content/ContentLinks.astro";
import Icon from "../ui/Icon.astro";
import { isSiteAuthor } from "../../utils/publications";

interface Props {
  id: string;
  publication: CollectionEntry<"publications">["data"];
}

const { id, publication } = Astro.props;
const bibtex = publication.bibtex?.trim();
const bibtexId = `bibtex-${id}`;
---

<article class="publication-item">
  {publication.image && (
    <div class="publication-figure">
      <Image
        src={publication.image.src}
        alt={publication.image.alt}
        width={480}
        widths={[240, 480, 960, 1280]}
        quality={90}
        sizes="(max-width: 640px) calc(100vw - 2.5rem), 216px"
        loading="lazy"
      />
    </div>
  )}
  <div class="publication-details">
    <h3 class="publication-title">{publication.title}</h3>
    <p class="publication-authors">
      {publication.authors.map((author, index) => (
        <>
          {index > 0 && ", "}
          {isSiteAuthor(author) ? <strong>{author}</strong> : author}
        </>
      ))}
    </p>
    {publication.venue && <p class="publication-venue">{publication.venue}</p>}
    {publication.status && (
      <p class="publication-status">{publication.status}</p>
    )}
    <ContentLinks links={publication.links}>
      {bibtex && (
        <button
          type="button"
          class="resource-link"
          aria-expanded="false"
          aria-controls={bibtexId}
          data-bibtex-toggle
        >
          <Icon name="Braces" size={16} />
          <span>BibTeX</span>
        </button>
      )}
    </ContentLinks>
    {bibtex && (
      <div class="bibtex-panel" id={bibtexId} hidden>
        <div class="bibtex-header">
          <span>BibTeX</span>
          <button type="button" class="bibtex-copy" data-bibtex-copy>
            Copy
          </button>
        </div>
        <pre><code>{bibtex}</code></pre>
      </div>
    )}
  </div>
</article>

<script>
  document.addEventListener("click", async (event) => {
    if (!(event.target instanceof Element)) return;

    const toggle = event.target.closest<HTMLButtonElement>(
      "[data-bibtex-toggle]",
    );
    if (toggle) {
      const panel = document.getElementById(
        toggle.getAttribute("aria-controls") ?? "",
      );
      if (!panel) return;
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!expanded));
      panel.hidden = expanded;
      return;
    }

    const copy = event.target.closest<HTMLButtonElement>("[data-bibtex-copy]");
    const code = copy?.closest(".bibtex-panel")?.querySelector("code");
    if (!copy || !code) return;
    try {
      await navigator.clipboard.writeText(code.textContent ?? "");
      copy.textContent = "Copied";
    } catch {
      copy.textContent = "Copy failed";
    }
    setTimeout(() => {
      copy.textContent = "Copy";
    }, 1600);
  });
</script>
