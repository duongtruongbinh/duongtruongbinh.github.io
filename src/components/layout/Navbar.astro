---
import { NAV_LINKS, THEME_CONFIG } from "../../config";
import Icon from "../ui/Icon.astro";

const currentPath = Astro.url.pathname;
---

<nav class="navbar" aria-label="Primary navigation">
  <ul class="nav-links">
    {NAV_LINKS.map((link) => {
      const isCurrent =
        currentPath === link.href ||
        (link.href !== "/" && currentPath.startsWith(`${link.href}/`));

      return (
        <li>
          <a
            href={link.href}
            data-astro-reload={link.href.endsWith(".pdf") ? "" : undefined}
            aria-current={isCurrent ? "page" : undefined}
            class={`nav-link ${isCurrent ? "active" : "inactive"}`}
          >
            {link.label}
            <span class="nav-link-line" aria-hidden="true" />
          </a>
        </li>
      );
    })}
  </ul>
  {THEME_CONFIG.lightAndDark && (
    <button
      id="theme-toggle"
      type="button"
      aria-label="Switch to dark mode"
      aria-pressed="false"
      class="btn-icon"
    >
      <Icon name="Sun" size={20} class="hidden dark:block" />
      <Icon name="Moon" size={20} class="block dark:hidden" />
    </button>
  )}
</nav>
