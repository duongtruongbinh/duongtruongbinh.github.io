---
import { SITE } from "../../config";

const currentYear = new Date().getFullYear();
const updatedDate = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
}).format(new Date(`${SITE.lastUpdated}T12:00:00Z`));
---

<footer class="footer">
  <div class="footer-copy">
    <span class="body-xs">
      &copy; {currentYear} {SITE.author}.
    </span>
    <span class="body-xs">
      Last updated: <time datetime={SITE.lastUpdated}>{updatedDate}</time>
    </span>
  </div>
</footer>
