---
import { SITE, VISITOR_MAP } from "../../config";

const imageURL = new URL("https://mapmyvisitors.com/map.png");
// Match the displayed width so the built-in pageview text stays legible.
imageURL.search = new URLSearchParams({
  d: VISITOR_MAP.widgetId,
  w: "600",
}).toString();

const isHome = Astro.url.pathname === "/";
---

<section
  class="visitor-section"
  aria-labelledby="visitors-heading"
  data-visitor-map
  data-production-host={new URL(SITE.website).hostname}
  data-show-map={String(isHome)}
  hidden
>
  <h2 id="visitors-heading" class="section-title">
    Visitors
  </h2>
  <a
    class="visitor-map"
    href={VISITOR_MAP.statsUrl}
    target="_blank"
    rel="noopener noreferrer"
  >
    <img
      data-src={imageURL.href}
      data-preview-src="/visitor-map-preview.png"
      width="600"
      height="317"
      alt="World map showing approximate visitor locations. Open geographic visitor statistics."
      decoding="async"
      fetchpriority="low"
    />
  </a>
</section>

{isHome && (
  <noscript>
    <section
      class="visitor-section"
      aria-labelledby="visitors-heading-noscript"
    >
      <h2 id="visitors-heading-noscript" class="section-title">
        Visitors
      </h2>
      <a class="visitor-map" href={VISITOR_MAP.statsUrl}>
        <img
          src="/visitor-map-preview.png"
          width="600"
          height="317"
          alt="Visitor map preview. Open live visitor statistics."
        />
      </a>
    </section>
  </noscript>
)}

<script is:inline>
  {
    const visitorMap = document.querySelector("[data-visitor-map]");
    if (visitorMap) {
      const image = visitorMap.querySelector("img");
      image.addEventListener("error", () => {
        image.hidden = true;
      });
      // Count production visits only; previews show a local snapshot instead.
      if (window.location.hostname === visitorMap.dataset.productionHost) {
        // Every new colour set is another counter request, so each theme's
        // image is built once and reused when the theme is toggled back.
        const sources = {};
        const showThemedMap = () => {
          const root = document.documentElement;
          const theme = root.getAttribute("data-theme") || "light";
          if (!sources[theme]) {
            const url = new URL(image.dataset.src);
            const colors = getComputedStyle(root);
            for (const [parameter, token] of Object.entries({
              co: "--background",
              cl: "--map-land",
              ct: "--foreground",
              cmn: "--accent",
              cmo: "--accent",
            })) {
              url.searchParams.set(
                parameter,
                colors.getPropertyValue(token).trim().replace("#", ""),
              );
            }
            sources[theme] = url.href;
          }
          image.src = sources[theme];
        };
        showThemedMap();
        document.addEventListener("themechange", showThemedMap);
      } else {
        image.src = image.dataset.previewSrc;
        image.alt = "Visitor map preview. Open live visitor statistics.";
      }
      visitorMap.hidden = visitorMap.dataset.showMap !== "true";
    }
  }
</script>
