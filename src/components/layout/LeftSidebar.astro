---
import { SOCIALS, SOCIAL_ICONS } from "../../config";
import { getCollection } from "astro:content";
import Icon from "../ui/Icon.astro";

const bioCollection = await getCollection("bio");
const bio = bioCollection[0]?.data;
const email = SOCIALS.find((social) => social.name === "Mail");
const academicLinks = SOCIALS.filter((social) => social.name !== "Mail");
---

<aside
  class="sidebar"
  aria-label="Profile"
  transition:persist="profile-sidebar"
>
  <div class="profile">
    {bio?.avatar && (
      <img
        src={`/${bio.avatar}`}
        alt={`${bio.name} presenting research at ICISN 2025`}
        width={160}
        height={160}
        class="sidebar-avatar"
        loading="eager"
        fetchpriority="high"
      />
    )}
    <div class="profile-details">
      {bio?.name && <div class="sidebar-name">{bio.name}</div>}
      {bio?.institution && (
        <p class="sidebar-info">
          <span>{bio.role} ·</span>
          <a
            class="institution-link"
            href="https://inrs.ca/"
            aria-label="Institut national de la recherche scientifique (INRS)"
            target="_blank"
            rel="noopener noreferrer"
          >
            <img
              class="institution-logo institution-logo-light"
              src="/inrs-logo.png"
              alt=""
              width={75}
              height={108}
            />
            <img
              class="institution-logo institution-logo-dark"
              src="/inrs-logo-white.png"
              alt=""
              width={75}
              height={108}
            />
          </a>
        </p>
      )}
      {bio?.shortBio && <p class="sidebar-bio">{bio.shortBio}</p>}
      {email && (
        <a class="profile-email" href={email.href}>
          <Icon name="Mail" size={16} />
          <span>{email.href.replace("mailto:", "")}</span>
        </a>
      )}
      <div class="profile-socials">
        {academicLinks.map((social) => (
          <a
            href={social.href}
            aria-label={social.linkTitle}
            title={social.linkTitle}
            target="_blank"
            rel="noreferrer"
            class="social-link"
          >
            <Icon name={SOCIAL_ICONS[social.name] || social.name} size={16} />
            <span>{social.name}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</aside>
