---
import { SOCIALS, SOCIAL_ICONS } from "../../config";
import { getCollection } from "astro:content";
import Icon from "../ui/Icon.astro";

const bioCollection = await getCollection("bio");
const bio = bioCollection[0]?.data;
---

<aside class="sidebar" aria-label="Profile">
  <div class="profile">
    {bio?.avatar && (
      <img
        src={`/${bio.avatar}`}
        alt={`${bio.name} presenting research at ICISN 2025`}
        width={160}
        height={160}
        class="sidebar-avatar"
        loading="eager"
        fetchpriority="high"
      />
    )}
    <div class="profile-details">
      {bio?.name && <div class="sidebar-name">{bio.name}</div>}
      {bio?.institution && (
        <p class="sidebar-info">
          <Icon name="Institution" size={16} />
          <span>
            {bio.role} · {bio.institution}
          </span>
        </p>
      )}
      {bio?.shortBio && <p class="sidebar-bio">{bio.shortBio}</p>}
      <div class="profile-socials">
        {SOCIALS.map((social) => (
          <a
            href={social.href}
            aria-label={social.linkTitle}
            title={social.linkTitle}
            target="_blank"
            rel="noreferrer"
            class="social-link"
          >
            <Icon name={SOCIAL_ICONS[social.name] || social.name} size={24} />
          </a>
        ))}
      </div>
    </div>
  </div>
</aside>
