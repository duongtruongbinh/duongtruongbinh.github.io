---
import Icon from "../ui/Icon.astro";

interface ResourceLink {
  label: string;
  href: string;
}

interface Props {
  links: ResourceLink[];
}

const { links } = Astro.props;

function getIconName(label: string): string {
  const normalized = label.toLowerCase();
  if (normalized.startsWith("arxiv")) return "Arxiv";
  if (normalized.startsWith("code")) return "Github";
  if (normalized.startsWith("paper") || normalized.startsWith("pdf")) {
    return "FileText";
  }
  return "ExternalLink";
}
---

{links.length > 0 && (
  <div class="item-links">
    {links.map((link) => (
      <a
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        class="resource-link"
      >
        <Icon name={getIconName(link.label)} size={16} />
        <span>{link.label}</span>
      </a>
    ))}
  </div>
)}
