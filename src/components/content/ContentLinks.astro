---
import Icon from "../ui/Icon.astro";

interface ResourceLink {
  label: string;
  href: string;
}

interface Props {
  links: ResourceLink[];
  className?: string;
}

const { links, className = "" } = Astro.props;
---

{links.length > 0 && (
  <div class={`item-links ${className}`}>
    {links.map((link) => (
      <a
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        class="resource-link"
      >
        <Icon name="ExternalLink" size={12} />
        <span>{link.label}</span>
      </a>
    ))}
  </div>
)}
