---
import { getCollection } from "astro:content";
import PublicationItem from "../../components/publications/PublicationItem.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isSiteAuthor, publicationYear } from "../../utils/publications";

const isFirstAuthor = (authors: string[]) =>
  authors.length > 0 && isSiteAuthor(authors[0]);

const publications = (await getCollection("publications")).sort(
  (a, b) =>
    publicationYear(b.data.date) - publicationYear(a.data.date) ||
    Number(isFirstAuthor(b.data.authors)) -
      Number(isFirstAuthor(a.data.authors)) ||
    b.data.date.localeCompare(a.data.date) ||
    a.data.title.localeCompare(b.data.title),
);
const years = [
  ...new Set(publications.map(({ data }) => publicationYear(data.date))),
];
---

<BaseLayout
  title="Publications"
  description="Peer-reviewed publications and preprints in multimodal learning, visual reasoning, and robust AI."
>
  <div class="container-narrow">
    <header class="page-header">
      <h1 class="page-title">Publications</h1>
      <p class="page-subtitle">
        * equal contribution · full list on{" "}
        <a href="https://scholar.google.com/citations?user=GW6kjhEAAAAJ&hl=en">
          Google Scholar
        </a>
      </p>
    </header>

    <div>
      {years.map((year) => (
        <section
          class="publication-year-group"
          aria-labelledby={`year-${year}`}
        >
          <h2 id={`year-${year}`} class="publication-year">
            {year}
          </h2>
          <div class="publication-list">
            {publications
              .filter(({ data }) => publicationYear(data.date) === year)
              .map(({ id, data }) => (
                <PublicationItem id={id} publication={data} />
              ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
