---
import { getCollection } from "astro:content";
import PublicationItem from "../../components/publications/PublicationItem.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const publications = (await getCollection("publications")).sort(
  (a, b) =>
    b.data.year - a.data.year || a.data.title.localeCompare(b.data.title),
);
const years = [...new Set(publications.map(({ data }) => data.year))];
---

<BaseLayout
  title="Publications"
  description="Peer-reviewed publications and preprints in multimodal learning, visual reasoning, and robust AI."
>
  <div class="container-narrow">
    <header class="page-header">
      <h1 class="page-title">Publications</h1>
      <p class="page-subtitle">
        * equal contribution · full list on{" "}
        <a href="https://scholar.google.com/citations?user=GW6kjhEAAAAJ&hl=en">
          Google Scholar
        </a>
      </p>
    </header>

    <div>
      {years.map((year) => (
        <section
          class="publication-year-group"
          aria-labelledby={`year-${year}`}
        >
          <h2 id={`year-${year}`} class="publication-year">
            {year}
          </h2>
          <div class="publication-list">
            {publications
              .filter(({ data }) => data.year === year)
              .map(({ data }) => (
                <PublicationItem publication={data} />
              ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
