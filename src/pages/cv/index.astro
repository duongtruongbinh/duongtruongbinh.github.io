---
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Timeline from "../../components/ui/Timeline.astro";

const cvEntry = await getEntry("cv", "cv");
if (!cvEntry) {
  throw new Error(
    "CV content not found. Please ensure src/content/cv.md exists.",
  );
}

const { experience = [], education = [] } = cvEntry.data;
---

<BaseLayout title="Curriculum Vitae">
  <div class="container-narrow">
    <header class="page-header">
      <h1 class="page-title">Curriculum Vitae</h1>
      <p class="page-subtitle">Education and research experience.</p>
    </header>

    {education.length > 0 && (
      <section class="section">
        <h2 class="section-title">Education</h2>
        <Timeline
          items={education.map((edu) => ({
            title: edu.degree,
            subtitle: edu.institution,
            period: edu.period,
            description: edu.description,
            thesis: edu.thesis,
          }))}
        />
      </section>
    )}

    {experience.length > 0 && (
      <section class="section">
        <h2 class="section-title">Research &amp; Teaching Experience</h2>
        <Timeline
          items={experience.map((exp) => ({
            title: exp.role,
            subtitle: exp.institution,
            period: exp.period,
            description: exp.description,
          }))}
        />
      </section>
    )}
  </div>
</BaseLayout>
