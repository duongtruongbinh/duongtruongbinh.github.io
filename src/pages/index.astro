---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsList from "../components/home/NewsList.astro";
import ResearchLoop from "../components/home/ResearchLoop.astro";

const bioEntry = await getEntry("bio", "bio");
if (!bioEntry) {
  throw new Error(
    "Bio content not found. Please ensure src/content/bio.md exists.",
  );
}

const { Content: BioContent } = await render(bioEntry);
---

<BaseLayout title="Home">
  <div class="container-narrow">
    <header class="page-header">
      <h1 class="page-title">About</h1>
    </header>

    <section class="page-section prose" aria-label="About Truong-Binh Duong">
      <BioContent />
      <ResearchLoop />
    </section>

    <NewsList />

    <section class="page-section" aria-labelledby="research-interests-heading">
      <h2 id="research-interests-heading" class="section-title">
        Research Interests
      </h2>
      <ul class="research-interests" role="list">
        {bioEntry.data.researchInterests.map((interest) => (
          <li>
            <div>
              <h3>{interest.title}</h3>
              <p class="research-context">{interest.context}</p>
            </div>
            <p>{interest.description}</p>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
